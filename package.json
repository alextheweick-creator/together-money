{
  "name": "together-money",
  "version": "0.1.1",
  "description": "A daily money check-in for two",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Together",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "start": "electron .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "electron-updater": "6.8.9",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "supabase": "^2.119.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
